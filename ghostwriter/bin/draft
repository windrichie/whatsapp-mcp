#!/bin/sh
# Prints a draft reply for one customer chat as JSON: {"reply": "...", "note": "..."}.
# The bridge runs this as WHATSAPP_DRAFT_COMMAND. Usage: draft <chat_jid>
set -eu

if [ "$#" -ne 1 ] || [ -z "$1" ]; then
    echo "usage: draft <chat_jid>" >&2
    exit 2
fi

# Find this script's own directory, following symlinks (macOS has no `readlink -f`).
src=$0
while [ -h "$src" ]; do
    link=$(readlink "$src")
    case $link in
        /*) src=$link ;;
        *) src=$(dirname "$src")/$link ;;
    esac
done
dir=$(cd "$(dirname "$src")" && pwd -P)

exec "${GHOSTWRITER_PYTHON:-python3}" -I "$dir/../scripts/gw_draft.py" draft "$1"
